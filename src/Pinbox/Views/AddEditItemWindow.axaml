<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Pinbox.Views.AddEditItemWindow"
        Width="440" SizeToContent="Height"
        Background="{DynamicResource SurfaceBrush}"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20" Spacing="4">
    <TextBlock x:Name="TitleText" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>

    <TextBlock x:Name="SubjectLabel" Text="Subject" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,6"/>
    <TextBox x:Name="SubjectBox" Watermark="e.g. Refund policy" Margin="0,0,0,10"/>

    <TextBlock x:Name="TypeLabel" Text="Type" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,6"/>
    <Grid ColumnDefinitions="*,*" Margin="0,0,0,10">
      <ToggleButton x:Name="TextTypeBtn" Grid.Column="0" Content="Text" Click="OnTextTypeClick" HorizontalContentAlignment="Center"/>
      <ToggleButton x:Name="PicTypeBtn" Grid.Column="1" Content="Picture" Click="OnPicTypeClick" HorizontalContentAlignment="Center" Margin="6,0,0,0"/>
    </Grid>

    <TextBlock x:Name="ContentLabel" Text="Content" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,6"/>

    <TextBox x:Name="TextBox" AcceptsReturn="True" TextWrapping="Wrap" Height="96" FontFamily="Consolas" FontSize="12.5"/>
    <TextBlock x:Name="PlaceholderHint" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,6,0,0"
               Text="Use {name} as a placeholder — Pinbox will ask you to fill it in before sending."/>

    <Border x:Name="DropZone" IsVisible="False" BorderThickness="1.5" BorderBrush="{DynamicResource BorderBrush2}"
            CornerRadius="10" Background="{DynamicResource Surface2Brush}" Padding="16">
      <StackPanel HorizontalAlignment="Center" Spacing="6">
        <TextBlock x:Name="DropStatusText" Text="Drag &amp; drop an image here" FontSize="12" Foreground="{DynamicResource TextDimBrush}" HorizontalAlignment="Center"/>
        <Button x:Name="BrowseButton" Content="Browse files…" Click="OnBrowseClick" HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>

    <TextBlock x:Name="LabelsLabel" Text="Labels" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextDimBrush}" Margin="0,12,0,6"/>
    <WrapPanel x:Name="LabelsPanel"/>

    <TextBlock x:Name="TemplateLink" Text="Start from a template…" FontSize="11.5" FontWeight="SemiBold"
               Foreground="{DynamicResource AccentBrush}" Cursor="Hand" PointerPressed="OnTemplateClick" Margin="0,10,0,0"/>

    <Border x:Name="ErrorBox" Background="{DynamicResource MauveSoftBrush}" CornerRadius="7" Padding="10,8" Margin="0,10,0,0" IsVisible="False">
      <TextBlock x:Name="ErrorText" Foreground="{DynamicResource MauveBrush}" FontSize="12" TextWrapping="Wrap"/>
    </Border>

    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,16,0,0">
      <Button x:Name="PreviewButton" Grid.Column="0" Content="Preview image" IsVisible="False" Click="OnPreviewClick"/>
      <Button x:Name="CancelButton" Grid.Column="2" Content="Cancel" Click="OnCancel" Margin="0,0,8,0"/>
      <Button x:Name="SaveButton" Grid.Column="3" Content="Save item" Click="OnSave" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentInkBrush}" FontWeight="SemiBold"/>
    </Grid>
  </StackPanel>
</Window>
