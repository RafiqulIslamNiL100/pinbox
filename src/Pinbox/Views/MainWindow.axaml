<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Pinbox.Views"
        x:Class="Pinbox.Views.MainWindow"
        Title="Pinbox"
        Width="900" Height="640" MinWidth="480" MinHeight="480"
        Background="{DynamicResource SurfaceBrush}"
        Closing="OnClosing">

  <Grid RowDefinitions="Auto,*">

    <Border x:Name="UpdateBanner" Grid.Row="0" Background="{DynamicResource AccentBrush}"
            Padding="14,8" IsVisible="False">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock x:Name="UpdateBannerText" Grid.Column="0" Foreground="{DynamicResource AccentInkBrush}"
                   FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <Button Grid.Column="1" x:Name="UpdateNowButton" Content="Update now" Click="OnUpdateNow"
                Margin="10,0" Padding="12,5" CornerRadius="7"
                Background="{DynamicResource AccentInkBrush}" Foreground="{DynamicResource AccentSoftBrush}"
                FontSize="12" FontWeight="SemiBold"/>
        <TextBlock Grid.Column="2" Text="Later" Foreground="{DynamicResource AccentInkBrush}" FontSize="12"
                   TextDecorations="Underline" Cursor="Hand" PointerPressed="OnDismissUpdate"
                   VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <views:SignInView x:Name="SignInViewControl"/>
      <views:SignUpView x:Name="SignUpViewControl" IsVisible="False"/>
      <views:ActivateKeyView x:Name="ActivateKeyViewControl" IsVisible="False"/>
      <views:MainView x:Name="MainViewControl" IsVisible="False"/>
    </Grid>

  </Grid>
</Window>
