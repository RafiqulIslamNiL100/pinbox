<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Pinbox.Views.MainView">
  <Grid RowDefinitions="Auto,*,Auto">

    <StackPanel Grid.Row="0" Margin="20,16,20,14" Spacing="14">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="Saved messages" FontSize="17" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource AccentBrush}">
            <TextBlock x:Name="AcctInitial" Text="?" FontSize="11" FontWeight="Bold"
                       Foreground="{DynamicResource AccentInkBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock x:Name="AcctName" FontSize="12" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
          <TextBlock x:Name="SignOutText" Text="Sign out" FontSize="12" Foreground="{DynamicResource TextDimBrush}"
                     TextDecorations="Underline" Cursor="Hand" PointerPressed="OnSignOut" VerticalAlignment="Center"/>
        </StackPanel>
      </Grid>
      <Grid ColumnDefinitions="*,Auto">
        <TextBox Grid.Column="0" x:Name="NewMessageBox" Watermark="Write a new message to save…"
                  Margin="0,0,8,0" KeyDown="OnNewMessageKeyDown"/>
        <Button Grid.Column="1" Content="Save" Click="OnAddMessage"
                Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentInkBrush}"
                FontWeight="SemiBold" Padding="14,8" CornerRadius="7"/>
      </Grid>
    </StackPanel>
    <Border Grid.Row="0" Height="1" Background="{DynamicResource BorderBrush2}" VerticalAlignment="Bottom"/>

    <ScrollViewer Grid.Row="1">
      <StackPanel x:Name="MessageList" Margin="10,6" Spacing="2"/>
    </ScrollViewer>

    <Grid Grid.Row="2" Background="{DynamicResource Surface2Brush}">
      <Border Height="1" Background="{DynamicResource BorderBrush2}" VerticalAlignment="Top"/>
      <Grid ColumnDefinitions="*,Auto" Margin="16,9">
        <TextBlock Grid.Column="0" x:Name="MsgCount" Text="0 saved messages" FontSize="11.5"
                   Foreground="{DynamicResource TextDimBrush}"/>
        <TextBlock Grid.Column="1" x:Name="FlashText" FontSize="11.5"
                   Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" IsVisible="False"/>
      </Grid>
    </Grid>

  </Grid>
</UserControl>
