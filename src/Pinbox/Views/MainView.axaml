<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Pinbox.Views.MainView">
  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- appbar: brand + page tabs + new page -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="14,10,14,8">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" Margin="0,0,10,0">
        <TextBlock Text="Pinbox" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextBrush}"/>
      </StackPanel>

      <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel x:Name="PageTabsPanel" Orientation="Horizontal" Spacing="4"/>
      </ScrollViewer>

      <TextBlock Grid.Column="2" x:Name="NewPageButton" Text="+ New page" FontSize="12" FontWeight="SemiBold"
                 Foreground="{DynamicResource AccentBrush}" Cursor="Hand" PointerPressed="OnNewPageClick"
                 VerticalAlignment="Center" Margin="10,0,0,0"/>
    </Grid>
    <Border Grid.Row="0" Height="1" Background="{DynamicResource BorderBrush2}" VerticalAlignment="Bottom"/>

    <!-- toolbar -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="14,8">
      <Border Grid.Column="0" x:Name="SearchBoxBorder" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush2}"
              BorderThickness="1" CornerRadius="9" Padding="12,8" Margin="0,0,8,0">
        <Grid ColumnDefinitions="Auto,*">
          <Path Grid.Column="0" Data="M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14z M21 21l-4.3-4.3"
                Stroke="{DynamicResource TextFaintBrush}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBox Grid.Column="1" x:Name="SearchBox" Classes="plain" Watermark="Search items…" TextChanged="OnSearchChanged"
                    VerticalAlignment="Center"/>
        </Grid>
      </Border>
      <ToggleButton Grid.Column="1" x:Name="MultiSelectToggle" Padding="7,5" Margin="0,0,8,0"
                    Click="OnMultiSelectToggle">
        <Path Data="M4 4h16v16H4z M8 12l3 3 6-6" Stroke="{DynamicResource TextDimBrush}"
              StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
              Width="13" Height="13" Stretch="Uniform"/>
      </ToggleButton>
      <Button Grid.Column="2" x:Name="AddItemButton" Content="+ Add item" Click="OnAddItemClick"
              Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentInkBrush}"
              FontWeight="SemiBold" Padding="14,7" CornerRadius="7"/>
    </Grid>
    <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderSoftBrush}" VerticalAlignment="Bottom"/>

    <!-- item list -->
    <ScrollViewer Grid.Row="2">
      <StackPanel x:Name="ItemList" Margin="8,4" Spacing="1"/>
    </ScrollViewer>

    <!-- bottom nav -->
    <Grid Grid.Row="3" Background="{DynamicResource Surface2Brush}">
      <Border Height="1" Background="{DynamicResource BorderBrush2}" VerticalAlignment="Top"/>
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,7">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
          <Border x:Name="FolderButton" Background="Transparent" Padding="6" Cursor="Hand" PointerPressed="OnOpenFolderClick">
            <Path Data="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"
                  Stroke="{DynamicResource TextDimBrush}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                  Width="14" Height="14" Stretch="Uniform"/>
          </Border>
          <Border x:Name="EyeButton" Background="Transparent" Padding="6" Cursor="Hand" PointerPressed="OnToggleRevealClick">
            <Path x:Name="EyeIcon" Data="M2 12s3.6-6.5 10-6.5 10 6.5 10 6.5-3.6 6.5-10 6.5-10-6.5-10-6.5z M12 9a3 3 0 1 0 0 6 3 3 0 1 0 0-6z"
                  Stroke="{DynamicResource TextDimBrush}" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                  Width="14" Height="14" Stretch="Uniform"/>
          </Border>
        </StackPanel>
        <TextBlock Grid.Column="1" x:Name="MsgCount" Text="0 saved items" FontSize="11" HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"/>
        <Border Grid.Column="2" x:Name="SettingsButton" Background="Transparent" Padding="6" Cursor="Hand" PointerPressed="OnSettingsClick">
          <Path Data="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6V21a2 2 0 1 1-4 0v-.2a1.7 1.7 0 0 0-1-1.5 1.7 1.7 0 0 0-1.9.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.6-1H3a2 2 0 1 1 0-4h.2a1.7 1.7 0 0 0 1.5-1 1.7 1.7 0 0 0-.3-1.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.9.3H9a1.7 1.7 0 0 0 1-1.6V3a2 2 0 1 1 4 0v.2a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.9-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.9V9a1.7 1.7 0 0 0 1.6 1H21a2 2 0 1 1 0 4h-.2a1.7 1.7 0 0 0-1.5 1z"
                Stroke="{DynamicResource TextDimBrush}" StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round"
                Width="14" Height="14" Stretch="Uniform"/>
        </Border>
      </Grid>
    </Grid>

    <!-- toast + bulk bar overlay -->
    <Border Grid.Row="2" x:Name="FlashToast" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16"
            Background="{DynamicResource AccentBrush}" CornerRadius="20" Padding="14,8" IsVisible="False">
      <TextBlock x:Name="FlashText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentInkBrush}"/>
    </Border>

    <Border Grid.Row="2" x:Name="BulkBar" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16"
            Background="{DynamicResource TextBrush}" CornerRadius="10" Padding="10,8" IsVisible="False">
      <StackPanel Orientation="Horizontal" Spacing="14">
        <TextBlock x:Name="BulkCountText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BgBrush}" VerticalAlignment="Center"/>
        <TextBlock x:Name="BulkDeleteText" Text="Delete selected" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource MauveBrush}" Cursor="Hand"
                   PointerPressed="OnBulkDeleteClick" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>

  </Grid>
</UserControl>
