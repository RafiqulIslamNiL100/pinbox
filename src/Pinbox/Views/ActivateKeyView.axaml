<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Pinbox.Views.ActivateKeyView">
  <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="320">
    <StackPanel Spacing="0">
      <Border Width="44" Height="44" CornerRadius="11" Background="{DynamicResource GoldSoftBrush}"
              HorizontalAlignment="Left" Margin="0,0,0,16">
        <Path Data="M6 11V8a6 6 0 1 1 12 0v3 M5 11h14v9H5z" Stroke="{DynamicResource GoldBrush}"
              StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
              Width="18" Height="18" Stretch="Uniform"
              HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>

      <TextBlock x:Name="TitleText" Text="Enter your key" FontSize="20" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
      <TextBlock x:Name="LedeText" Text="Pinbox is locked until you activate it with a key."
                 FontSize="12.5" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,18"/>

      <Border x:Name="ErrorBox" Background="{DynamicResource MauveSoftBrush}" CornerRadius="7" Padding="10,8"
              Margin="0,0,0,14" IsVisible="False">
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource MauveBrush}" FontSize="12.5"
                   TextWrapping="Wrap"/>
      </Border>

      <TextBlock x:Name="KeyLabel" Text="Unique key" FontSize="11.5" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,6"/>
      <TextBox x:Name="KeyBox" Classes="field" Watermark="XXXX-XXXX-XXXX-XXXX" FontFamily="Consolas" Margin="0,0,0,4"/>

      <Button x:Name="ActivateButton" Content="Activate" HorizontalAlignment="Stretch" Margin="0,20,0,0"
              Classes="premium" Click="OnActivateClick"/>

      <TextBlock x:Name="SignOutLink" Text="Sign out" FontSize="12" Foreground="{DynamicResource TextDimBrush}"
                 TextDecorations="Underline" HorizontalAlignment="Center" Margin="0,16,0,0"
                 Cursor="Hand" PointerPressed="OnSignOutClick"/>
    </StackPanel>
  </Grid>
</UserControl>
