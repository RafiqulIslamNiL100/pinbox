<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Pinbox.Views.SettingsWindow"
        Width="500" Height="460"
        Background="{DynamicResource SurfaceBrush}"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,Auto,*">
    <TextBlock x:Name="TitleText" Grid.Row="0" Text="Settings" FontSize="15" FontWeight="Bold" Margin="20,16,20,10"
               Foreground="{DynamicResource TextBrush}"/>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="16,0">
      <RadioButton x:Name="GeneralTabBtn" Content="General" GroupName="SettingsTab" Click="OnGeneralTabClick" IsChecked="True" Classes="segment"/>
      <RadioButton x:Name="AccountTabBtn" Content="Account &amp; data" GroupName="SettingsTab" Click="OnAccountTabClick" Classes="segment"/>
    </StackPanel>
    <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderSoftBrush}" VerticalAlignment="Bottom" Margin="0,8,0,0"/>

    <ScrollViewer Grid.Row="2">
    <Grid>
      <StackPanel x:Name="GeneralPanel" Margin="20,14">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
          <StackPanel Grid.Column="0"><TextBlock x:Name="HotkeyLabel" Text="Global hotkey" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextBrush}"/><TextBlock x:Name="HotkeyDesc" Text="Opens Pinbox from anywhere" FontSize="11" Foreground="{DynamicResource TextDimBrush}"/></StackPanel>
          <TextBox Grid.Column="1" x:Name="HotkeyBox" Classes="field" Width="150" Foreground="{DynamicResource TextDimBrush}"
                    HorizontalContentAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
          <StackPanel Grid.Column="0"><TextBlock x:Name="StartupLabel" Text="Start with Windows" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextBrush}"/><TextBlock x:Name="StartupDesc" Text="Launch Pinbox on login" FontSize="11" Foreground="{DynamicResource TextDimBrush}"/></StackPanel>
          <ToggleButton Grid.Column="1" x:Name="AutoStartToggle" Classes="switch" VerticalAlignment="Center"/>
        </Grid>
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
          <StackPanel Grid.Column="0"><TextBlock x:Name="CompactLabel" Text="Compact mode" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextBrush}"/><TextBlock x:Name="CompactDesc" Text="Use a smaller window by default" FontSize="11" Foreground="{DynamicResource TextDimBrush}"/></StackPanel>
          <ToggleButton Grid.Column="1" x:Name="CompactToggle" Classes="switch" VerticalAlignment="Center"/>
        </Grid>
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
          <StackPanel Grid.Column="0"><TextBlock x:Name="NotifLabel" Text="Windows notifications" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextBrush}"/><TextBlock x:Name="NotifDesc" Text="Show a system toast when a message is sent" FontSize="11" Foreground="{DynamicResource TextDimBrush}"/></StackPanel>
          <ToggleButton Grid.Column="1" x:Name="NotifToggle" Classes="switch" VerticalAlignment="Center"/>
        </Grid>
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
          <StackPanel Grid.Column="0"><TextBlock x:Name="ThemeLabel" Text="Theme" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextBrush}"/><TextBlock x:Name="ThemeDesc" Text="Override the Windows light/dark setting" FontSize="11" Foreground="{DynamicResource TextDimBrush}"/></StackPanel>
          <Border Grid.Column="1" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush2}"
                  BorderThickness="1" CornerRadius="11" Padding="3" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <RadioButton x:Name="ThemeLightBtn" Content="Light" GroupName="Theme" Classes="segment" Click="OnThemeClick"/>
              <RadioButton x:Name="ThemeDarkBtn" Content="Dark" GroupName="Theme" Classes="segment" Click="OnThemeClick"/>
              <RadioButton x:Name="ThemeSystemBtn" Content="System" GroupName="Theme" Classes="segment" Click="OnThemeClick"/>
            </StackPanel>
          </Border>
        </Grid>
        <Button x:Name="SaveGeneralBtn" Content="Save" Click="OnSaveGeneral" HorizontalAlignment="Right"
                Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentInkBrush}" FontWeight="SemiBold" CornerRadius="8"/>
      </StackPanel>

      <StackPanel x:Name="AccountPanel" Margin="20,14" IsVisible="False">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
          <StackPanel Grid.Column="0"><TextBlock x:Name="LicenseLabel" Text="License" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextBrush}"/><TextBlock x:Name="LicenseDesc" Text="" FontSize="11" Foreground="{DynamicResource TextDimBrush}"/></StackPanel>
          <Border Grid.Column="1" Background="{DynamicResource GoodSoftBrush}" CornerRadius="20" Padding="9,3" VerticalAlignment="Center">
            <TextBlock x:Name="LicenseBadge" Text="Active" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource GoodBrush}"/>
          </Border>
        </Grid>
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
          <StackPanel Grid.Column="0"><TextBlock x:Name="AccountLabel" Text="Account" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextBrush}"/><TextBlock x:Name="AccountEmail" FontSize="11" Foreground="{DynamicResource TextDimBrush}"/></StackPanel>
          <Button Grid.Column="1" x:Name="SignOutBtn" Content="Sign out" Click="OnSignOutClick" VerticalAlignment="Center" Classes="ghost"/>
        </Grid>
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
          <StackPanel Grid.Column="0"><TextBlock x:Name="LanguageLabel" Text="Language" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextBrush}"/><TextBlock x:Name="LanguageDesc" Text="Translates Pinbox's own interface only" FontSize="11" Foreground="{DynamicResource TextDimBrush}"/></StackPanel>
          <Border Grid.Column="1" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush2}"
                  BorderThickness="1" CornerRadius="20" Padding="3" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <RadioButton x:Name="LangEnBtn" Content="EN" GroupName="Lang" Classes="segment pill" Click="OnLangEnClick"/>
              <RadioButton x:Name="LangZhBtn" Content="中文" GroupName="Lang" Classes="segment pill" Click="OnLangZhClick"/>
            </StackPanel>
          </Border>
        </Grid>
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
          <StackPanel Grid.Column="0"><TextBlock x:Name="AutoLockLabel" Text="Auto-lock" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextBrush}"/><TextBlock x:Name="AutoLockDesc" Text="Require a PIN after being idle" FontSize="11" Foreground="{DynamicResource TextDimBrush}"/></StackPanel>
          <Border Grid.Column="1" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush2}"
                  BorderThickness="1" CornerRadius="11" Padding="3" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <RadioButton x:Name="AutoLockOffBtn" Content="Off" GroupName="AutoLock" Classes="segment"/>
              <RadioButton x:Name="AutoLock5Btn" Content="5m" GroupName="AutoLock" Classes="segment"/>
              <RadioButton x:Name="AutoLock15Btn" Content="15m" GroupName="AutoLock" Classes="segment"/>
            </StackPanel>
          </Border>
        </Grid>
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
          <StackPanel Grid.Column="0"><TextBlock x:Name="SetPinLabel" Text="Set PIN" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextBrush}"/><TextBlock x:Name="SetPinDesc" Text="Required if auto-lock is on" FontSize="11" Foreground="{DynamicResource TextDimBrush}"/></StackPanel>
          <TextBox Grid.Column="1" x:Name="PinBox" Classes="field" Width="100" PasswordChar="•" MaxLength="6" VerticalAlignment="Center"/>
        </Grid>
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
          <StackPanel Grid.Column="0"><TextBlock x:Name="BackupLabel" Text="Backup" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextBrush}"/><TextBlock x:Name="BackupDesc" Text="Export or import your pages and items" FontSize="11" Foreground="{DynamicResource TextDimBrush}"/></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="ExportBtn" Content="Export" Click="OnExportClick" Classes="ghost"/>
            <Button x:Name="ImportBtn" Content="Import" Click="OnImportClick" Classes="ghost"/>
          </StackPanel>
        </Grid>
        <Button x:Name="SaveAccountBtn" Content="Save" Click="OnSaveAccount" HorizontalAlignment="Right"
                Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentInkBrush}" FontWeight="SemiBold" CornerRadius="8"/>
      </StackPanel>
    </Grid>
    </ScrollViewer>
  </Grid>
</Window>
