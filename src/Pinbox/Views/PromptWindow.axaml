<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Pinbox.Views.PromptWindow"
        Width="360" SizeToContent="Height"
        Background="{DynamicResource SurfaceBrush}"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20" Spacing="12">
    <TextBlock x:Name="PromptLabel" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
    <TextBox x:Name="InputBox" KeyDown="OnKeyDown"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="CancelBtn" Content="Cancel" Click="OnCancel"/>
      <Button x:Name="OkBtn" Content="OK" Click="OnOk" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentInkBrush}" FontWeight="SemiBold"/>
    </StackPanel>
  </StackPanel>
</Window>
