<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Pinbox.App">

  <Application.Styles>
    <FluentTheme />

    <!-- chromeless text box: strips FluentTheme's own background, border and
         the accent-colored focus underline in every state, so a TextBox
         placed inside our own rounded search container reads as one clean
         box instead of a box-inside-a-box. -->
    <Style Selector="TextBox.plain">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="TextBox.plain /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="TextBox.plain:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="TextBox.plain:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- small pill toggle switch, used instead of default checkboxes -->
    <Style Selector="ToggleButton.switch">
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="21"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Grid>
            <Border x:Name="Track" CornerRadius="11" Background="{DynamicResource Surface3Brush}"
                    BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1"/>
            <Ellipse x:Name="Thumb" Width="15" Height="15" Fill="{DynamicResource TextFaintBrush}"
                     HorizontalAlignment="Left" Margin="2,0,0,0"/>
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.switch:checked /template/ Border#Track">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="ToggleButton.switch:checked /template/ Ellipse#Thumb">
      <Setter Property="Fill" Value="{DynamicResource AccentInkBrush}"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="Margin" Value="0,0,2,0"/>
    </Style>

    <!-- segmented control option (Theme, Auto-lock, Language) - a RadioButton
         restyled to a plain content pill, so GroupName gives us mutual
         exclusivity for free instead of hand-rolled toggle logic. -->
    <Style Selector="RadioButton.segment">
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="SegBg" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
            <ContentPresenter Content="{TemplateBinding Content}" Margin="{TemplateBinding Padding}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.segment:checked /template/ Border#SegBg">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="RadioButton.segment:checked">
      <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}"/>
    </Style>
    <Style Selector="RadioButton.segment:pointerover /template/ Border#SegBg">
      <Setter Property="Background" Value="{DynamicResource Surface3Brush}"/>
    </Style>
    <Style Selector="RadioButton.segment:checked:pointerover /template/ Border#SegBg">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <!-- a rounder variant for the two-option language toggle -->
    <Style Selector="RadioButton.segment.pill">
      <Setter Property="CornerRadius" Value="20"/>
      <Setter Property="Padding" Value="13,6"/>
    </Style>

    <!-- Right-click menu: pin every part to our palette. Without this, the
         menu's selection/separator picks up the user's Windows accent color,
         which bleeds orange/red on PCs whose accent isn't purple. -->
    <Style Selector="ContextMenu">
      <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="5"/>
    </Style>
    <Style Selector="MenuItem">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="CornerRadius" Value="7"/>
    </Style>
    <Style Selector="MenuItem /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="7"/>
    </Style>
    <Style Selector="MenuItem:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource Surface3Brush}"/>
    </Style>
    <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource Surface3Brush}"/>
    </Style>
    <Style Selector="Separator">
      <Setter Property="Background" Value="{DynamicResource BorderBrush2}"/>
      <Setter Property="Height" Value="1"/>
      <Setter Property="Margin" Value="8,4"/>
    </Style>

    <!-- quiet outline button for secondary actions (Sign out, Export, Import) -->
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
    </Style>

    <!-- premium primary action button - Sign in / Sign up / Activate. A
         soft gradient plus a hairline highlight border reads as a deliberate,
         elevated action instead of a flat FluentTheme button, and the
         pointerover/pressed states nudge brightness for tactile feedback. -->
    <Style Selector="Button.premium">
      <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="0,12"/>
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Color="{DynamicResource SystemAccentColorLight1}" Offset="0"/>
          <GradientStop Color="{DynamicResource SystemAccentColor}" Offset="1"/>
        </LinearGradientBrush>
      </Setter>
      <Setter Property="Template">
        <ControlTemplate>
          <Border x:Name="PremiumBg" Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  BorderBrush="{DynamicResource SystemAccentColorLight2}" BorderThickness="1">
            <ContentPresenter Content="{TemplateBinding Content}"
                               Foreground="{TemplateBinding Foreground}"
                               FontWeight="{TemplateBinding FontWeight}"
                               FontSize="{TemplateBinding FontSize}"
                               Padding="{TemplateBinding Padding}"
                               HorizontalContentAlignment="Center"
                               VerticalContentAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.premium:pointerover /template/ Border#PremiumBg">
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Color="{DynamicResource SystemAccentColorLight2}" Offset="0"/>
          <GradientStop Color="{DynamicResource SystemAccentColorLight1}" Offset="1"/>
        </LinearGradientBrush>
      </Setter>
    </Style>
    <Style Selector="Button.premium:pressed /template/ Border#PremiumBg">
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Color="{DynamicResource SystemAccentColor}" Offset="0"/>
          <GradientStop Color="{DynamicResource SystemAccentColorDark1}" Offset="1"/>
        </LinearGradientBrush>
      </Setter>
    </Style>

    <!-- themed input field: Surface2/BorderBrush2 chrome instead of
         FluentTheme's default white box, for freestanding fields that sit
         directly on a settings row (hotkey capture, PIN) rather than inside
         our own bordered container like the search box. -->
    <Style Selector="TextBox.field">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style Selector="TextBox.field /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="TextBox.field:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="TextBox.field:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="BorderThickness" Value="1.4"/>
    </Style>
  </Application.Styles>

  <!-- Theme-scoped resources. RequestedThemeVariant (set by ThemeService)
       drives which dictionary is live, and Avalonia re-resolves every
       {DynamicResource ...} in every window automatically when it changes -
       at startup and on a live switch, for the main window and every dialog
       alike. Code-behind reads these with a theme-aware lookup
       (TryFindResource(key, ActualThemeVariant, out _) in MainView.Brush) so
       C#-built visuals resolve the same values. Overriding the FluentTheme
       SystemAccentColor ramp here keeps native controls (toggle switches,
       focus states) on our purple instead of the user's Windows accent. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="BgBrush">#14121D</SolidColorBrush>
          <SolidColorBrush x:Key="SurfaceBrush">#1C1928</SolidColorBrush>
          <SolidColorBrush x:Key="Surface2Brush">#262234</SolidColorBrush>
          <SolidColorBrush x:Key="Surface3Brush">#2B2538</SolidColorBrush>
          <SolidColorBrush x:Key="BorderBrush2">#383150</SolidColorBrush>
          <SolidColorBrush x:Key="BorderSoftBrush">#2A2536</SolidColorBrush>
          <SolidColorBrush x:Key="TextBrush">#ECE9F6</SolidColorBrush>
          <SolidColorBrush x:Key="TextDimBrush">#A59EBD</SolidColorBrush>
          <SolidColorBrush x:Key="TextFaintBrush">#6C6580</SolidColorBrush>
          <SolidColorBrush x:Key="AccentBrush">#A78BFA</SolidColorBrush>
          <SolidColorBrush x:Key="AccentInkBrush">#1C0F3E</SolidColorBrush>
          <SolidColorBrush x:Key="AccentSoftBrush">#322A4D</SolidColorBrush>
          <SolidColorBrush x:Key="MauveBrush">#D99BD0</SolidColorBrush>
          <SolidColorBrush x:Key="MauveSoftBrush">#35243A</SolidColorBrush>
          <SolidColorBrush x:Key="GoldBrush">#E0B23F</SolidColorBrush>
          <SolidColorBrush x:Key="GoldSoftBrush">#3A2F14</SolidColorBrush>
          <SolidColorBrush x:Key="GoodBrush">#4FD39A</SolidColorBrush>
          <SolidColorBrush x:Key="GoodSoftBrush">#173A2C</SolidColorBrush>
          <Color x:Key="SystemAccentColor">#A78BFA</Color>
          <Color x:Key="SystemAccentColorDark1">#9678E8</Color>
          <Color x:Key="SystemAccentColorDark2">#8566D1</Color>
          <Color x:Key="SystemAccentColorDark3">#7454BA</Color>
          <Color x:Key="SystemAccentColorLight1">#B79FFB</Color>
          <Color x:Key="SystemAccentColorLight2">#C7B3FC</Color>
          <Color x:Key="SystemAccentColorLight3">#D7C7FD</Color>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="BgBrush">#F6F3FB</SolidColorBrush>
          <SolidColorBrush x:Key="SurfaceBrush">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="Surface2Brush">#EFE9F9</SolidColorBrush>
          <SolidColorBrush x:Key="Surface3Brush">#E4DAF5</SolidColorBrush>
          <SolidColorBrush x:Key="BorderBrush2">#DDD2EF</SolidColorBrush>
          <SolidColorBrush x:Key="BorderSoftBrush">#E7E0F5</SolidColorBrush>
          <SolidColorBrush x:Key="TextBrush">#251F38</SolidColorBrush>
          <SolidColorBrush x:Key="TextDimBrush">#6D6484</SolidColorBrush>
          <SolidColorBrush x:Key="TextFaintBrush">#A297B8</SolidColorBrush>
          <SolidColorBrush x:Key="AccentBrush">#7C5CD9</SolidColorBrush>
          <SolidColorBrush x:Key="AccentInkBrush">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="AccentSoftBrush">#ECE2FB</SolidColorBrush>
          <SolidColorBrush x:Key="MauveBrush">#A1478C</SolidColorBrush>
          <SolidColorBrush x:Key="MauveSoftBrush">#F8E7F3</SolidColorBrush>
          <SolidColorBrush x:Key="GoldBrush">#A3760A</SolidColorBrush>
          <SolidColorBrush x:Key="GoldSoftBrush">#FAF0D6</SolidColorBrush>
          <SolidColorBrush x:Key="GoodBrush">#1F7A4C</SolidColorBrush>
          <SolidColorBrush x:Key="GoodSoftBrush">#D9F2E6</SolidColorBrush>
          <Color x:Key="SystemAccentColor">#7C5CD9</Color>
          <Color x:Key="SystemAccentColorDark1">#6A4BC4</Color>
          <Color x:Key="SystemAccentColorDark2">#583AAE</Color>
          <Color x:Key="SystemAccentColorDark3">#472999</Color>
          <Color x:Key="SystemAccentColorLight1">#8F6EE0</Color>
          <Color x:Key="SystemAccentColorLight2">#A282E7</Color>
          <Color x:Key="SystemAccentColorLight3">#B596ED</Color>
        </ResourceDictionary>

      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

</Application>
